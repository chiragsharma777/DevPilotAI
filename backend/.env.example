# Backend
APP_NAME=DevPilotAI
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8082
# Production requires HTTPS, a public frontend origin, and secure cookies.
# APP_ENV=production
# FRONTEND_URL=https://app.example.com
# FRONTEND_ORIGINS=https://app.example.com
# COOKIE_SECURE=true

# Sarvam AI (OpenAI-compatible Chat Completions)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8082/auth/github/callback
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:8082/auth/google/callback

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:8082/api/notion/callback

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set this only after adding the same address under Authentication > URL
# Configuration > Redirect URLs in Supabase.
SUPABASE_EMAIL_REDIRECT_URL=http://localhost:5173
# In Supabase Dashboard > Authentication, enable "Confirm email", set the
# Site URL, and add the redirect URL above to the allowed Redirect URLs.

# Instagram / Meta
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8082/api/instagram/callback

# Snapchat
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=http://127.0.0.1:8082/api/snapchat/callback
